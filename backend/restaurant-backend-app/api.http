### Create dish    ///// DISHES /////
< {%
    // 1. Read the file into Base64 using a native OS shell command
    const command = 'base64 -i /Users/ludmila/WebstormProjects/GreenTasty/frontend/restaurant-frontend-app/src/assets/img/dishes/spring-salad.jpg';
    // 2. Execute synchronously and retrieve the string output
    const base64String = execSync(command).trim();
    // 3. Save it to a dynamic request variable
    request.variables.set("file_data", base64String);
%}
POST https://ifwetfsxed.execute-api.us-east-1.amazonaws.com/develop/dishes
Content-Type: application/json

{
  "name": "Spring Salad Small",
  "description": "A light and refreshing seasonal salad featuring crisp radishes, fresh cucumbers, baby spinach, mixed lettuce, green peas, spring onions, and fresh dill, tossed with a delicate lemon-olive oil dressing.",
  "dishType": 0,
  "price": 6.90,
  "weight": "150 g",
  "calories": "155 kcal",
  "proteins": "5 g",
  "fats": "8 g",
  "carbohydrates": "14 g",
  "vitamins": "A, C, E, K, B9",
  "imageBase64": "{{file_data}}",
  "state": 2,
  "locationIds": ["75047b6e-0af0-4c58-aaee-7a528ff88298", "7d598da3-0887-4a04-a3a1-fe26d8a4a4f2"]
}

