### Auth register admin   ///// AUTH /////
POST https://ifwetfsxed.execute-api.us-east-1.amazonaws.com/develop/register
Content-Type: application/json

{
    "firstName": "John",
    "lastName": "Doe",
    "email": "john_doe@mail.com",
    "password": "1234SecurePass!",
    "confirmPassword": "1234SecurePass!"
}

