### Create locations    ///// LOCATIONS /////
POST https://ifwetfsxed.execute-api.us-east-1.amazonaws.com/develop/locations
Content-Type: application/json

{
  "address": "42 Haharina Avenue, Dnipro, Ukraine",
  "description": "Family-friendly restaurant serving traditional Ukrainian cuisine, homemade desserts, and fresh seasonal dishes. Features a children's play area.",
  "totalCapacity": 50,
  "averageOccupancy": "60%",
  "imageUrl": "https://GreenTasty/frontend/restaurant-frontend-app/src/assets/img/locations/rustaveli-avenue-48.jpg",
  "rating": 4.5
}

### Get locations
GET https://ifwetfsxed.execute-api.us-east-1.amazonaws.com/develop/locations

### Get local menu
GET https://ifwetfsxed.execute-api.us-east-1.amazonaws.com/develop/locations/75047b6e-0af0-4c58-aaee-7a528ff88298/dishes

### Delete dishec from local menu
DELETE https://ifwetfsxed.execute-api.us-east-1.amazonaws.com/develop/locations/06a24ef9-7b5a-4bbc-a630-4ed86601b846/dishes/e6a90681-778c-4355-89ac-418b885ed416
Authorization: Bearer ey*****sQ

### Edit locations
< {%
    // 1. Read the file into Base64 using a native OS shell command
    const command = 'base64 -i /Users/ludmila/WebstormProjects/GreenTasty/frontend/restaurant-frontend-app/src/assets/img/locations/haharina-avenue.jpg';
    // 2. Execute synchronously and retrieve the string output
    const base64String = execSync(command).trim();
    // 3. Save it to a dynamic request variable
    request.variables.set("file_data", base64String);
%}
PUT https://ifwetfsxed.execute-api.us-east-1.amazonaws.com/develop/locations/06a24ef9-7b5a-4bbc-a630-4ed86601b846
Content-Type: application/json
Authorization: Bearer ey*****sQ

{
  "address": "42 Haharina Avenue, Dnipro, Ukraine",
  "description": "Family-friendly restaurant serving traditional Ukrainian cuisine, homemade desserts, and fresh seasonal dishes. Features a children's play area.",
  "totalCapacity": 50,
  "averageOccupancy": "60%",
  "imageBase64": "{{file_data}}",
  "rating": 4.5
}

